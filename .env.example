# Copy to .env (repo root). The API, the worker and the collector all read this one file.

# PostgreSQL connection. For Supabase: dashboard -> Connect -> Session pooler -> URI, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Use the Session pooler (port 5432), not the Transaction pooler (6543): the collector
# takes a session-level advisory lock. Then run once:  python init_db.py
DATABASE_URL=

# Required. Any long random string: python -c "import secrets; print(secrets.token_hex(32))"
# Keep it the same between restarts: it signs Telegram links and encrypts saved channel contacts.
SECRET_KEY=

# Telegram: create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling

# Email: leave SMTP_HOST empty to print emails (and codes) in the console instead.
# Gmail example: smtp.gmail.com / 587 / your address / a 16-character App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional collector sources
NYT_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Optional worker pace in seconds (defaults: 900 / 120 / 120)
# SCRAPE_INTERVAL_SECONDS=
# CLASSIFY_INTERVAL_SECONDS=
# DISPATCH_INTERVAL_SECONDS=
