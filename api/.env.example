# Copy to api/.env and fill in what you need. Everything is optional for local dev.

# Any long random string. Keep it the same between restarts (signs Telegram links).
SECRET_KEY=change-me-to-a-long-random-string

# SQLite file by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ainews
DATABASE_URL=sqlite:///./ainews.db

# Telegram: create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling

# Email: leave SMTP_HOST empty to print emails (and codes) in the server console.
# Gmail example: smtp.gmail.com / 587 / your address / a 16-character App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
