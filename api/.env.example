# Copy to api/.env and fill in what you need. Only SECRET_KEY and DATABASE_URL are required.

# Required. Any long random string: python -c "import secrets; print(secrets.token_hex(32))"
# Keep it the same between restarts: it signs Telegram links and encrypts saved channel contacts.
SECRET_KEY=change-me-to-a-long-random-string

# The same PostgreSQL database the collector uses, created once with:  psql -d ainews -f schema.sql
# (falls back to COLLECTOR_DATABASE_URL from the repo-root .env)
DATABASE_URL=postgresql+psycopg:///ainews

# Telegram: create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling

# Email: leave SMTP_HOST empty to print emails (and codes) in the server console.
# Gmail example: smtp.gmail.com / 587 / your address / a 16-character App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
